<Window x:Class="Labb3_Quiz.Dialogs.ManageCategoriesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Categories" Height="360" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource AppWindowStyle}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox Grid.Column="0"
                 ItemsSource="{Binding Categories}"
                 SelectedItem="{Binding SelectedCategory}">
            <ListBox.DisplayMemberPath>Name</ListBox.DisplayMemberPath>
        </ListBox>

        <StackPanel Grid.Column="1" Margin="12 0 0 0">
            <TextBlock Text="Category name:" FontWeight="Bold"/>
            <TextBox Text="{Binding CategoryNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0 6 0 12"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Add" Width="90" Margin="0 0 8 0"
                        Command="{Binding AddCategoryCommand}"/>
                <Button Content="Rename" Width="90" Margin="0 0 8 0"
                        Command="{Binding RenameCategoryCommand}"/>
                <Button Content="Delete" Width="90"
                        Command="{Binding DeleteCategoryCommand}"/>
            </StackPanel>

            <TextBlock Margin="0 16 0 0" TextWrapping="Wrap"
                       Text="Obs: Ändringar här påverkar inte befintliga question packs" />
        </StackPanel>

        <Button Grid.Row="1" Grid.ColumnSpan="2"
                Content="Close" Width="100" Height="32"
                HorizontalAlignment="Right" Margin="0 12 0 0"
                IsCancel="True"/>
    </Grid>
</Window>
